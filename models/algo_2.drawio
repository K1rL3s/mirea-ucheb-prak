<mxfile host="drawio"><diagram id="algo" name="Схема алгоритма"><mxGraphModel grid="0" page="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="start" value="Начало" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=17;fontFamily=Times New Roman;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="240" y="0" width="180" height="44" as="geometry" /></mxCell><mxCell id="in" value="Ввод rental, segments, tariff, surcharge_types, zone_id" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=18;whiteSpace=wrap;html=1;fontSize=17;fontFamily=Times New Roman;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="180" y="66" width="300" height="56" as="geometry" /></mxCell><mxCell id="init" value="drive_min = 0; wait_min = 0" style="rounded=0;whiteSpace=wrap;html=1;fontSize=17;fontFamily=Times New Roman;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="190" y="139" width="280" height="56" as="geometry" /></mxCell><mxCell id="l1" value="Л1: для каждого сегмента s из segments" style="shape=loopLimit;whiteSpace=wrap;html=1;size=14;fontSize=17;fontFamily=Times New Roman;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="190" y="213" width="280" height="56" as="geometry" /></mxCell><mxCell id="d1" value="s.rental_id = rental.rental_id?" style="rhombus;whiteSpace=wrap;html=1;fontSize=17;fontFamily=Times New Roman;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="125" y="287" width="410" height="110" as="geometry" /></mxCell><mxCell id="duration" value="duration = s.finished_at - s.started_at" style="rounded=0;whiteSpace=wrap;html=1;fontSize=17;fontFamily=Times New Roman;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="190" y="402" width="280" height="56" as="geometry" /></mxCell><mxCell id="valid" value="duration ≥ 0 и mode из {движение, ожидание}?" style="rhombus;whiteSpace=wrap;html=1;fontSize=17;fontFamily=Times New Roman;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="125" y="476" width="410" height="110" as="geometry" /></mxCell><mxCell id="error" value="Ошибка: некорректный сегмент" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=18;whiteSpace=wrap;html=1;fontSize=17;fontFamily=Times New Roman;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="650" y="476" width="300" height="56" as="geometry" /></mxCell><mxCell id="error_end" value="Конец с ошибкой" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=17;fontFamily=Times New Roman;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="710" y="574" width="180" height="44" as="geometry" /></mxCell><mxCell id="min" value="minutes = ⌈duration / 60 с⌉" style="rounded=0;whiteSpace=wrap;html=1;fontSize=17;fontFamily=Times New Roman;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="190" y="590" width="280" height="56" as="geometry" /></mxCell><mxCell id="d2" value="s.mode = «движение»?" style="rhombus;whiteSpace=wrap;html=1;fontSize=17;fontFamily=Times New Roman;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="125" y="738" width="410" height="110" as="geometry" /></mxCell><mxCell id="drive" value="drive_min = drive_min + minutes" style="rounded=0;whiteSpace=wrap;html=1;fontSize=17;fontFamily=Times New Roman;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="10" y="853" width="280" height="56" as="geometry" /></mxCell><mxCell id="wait" value="wait_min = wait_min + minutes" style="rounded=0;whiteSpace=wrap;html=1;fontSize=17;fontFamily=Times New Roman;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="853" width="280" height="56" as="geometry" /></mxCell><mxCell id="e1" value="Л1" style="shape=loopLimit;whiteSpace=wrap;html=1;size=14;flipV=1;fontSize=17;fontFamily=Times New Roman;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="190" y="943" width="280" height="56" as="geometry" /></mxCell><mxCell id="cost" value="cost = drive_min · drive_price + wait_min · wait_price; surcharges = []" style="rounded=0;whiteSpace=wrap;html=1;fontSize=17;fontFamily